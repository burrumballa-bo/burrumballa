NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SMTP del form contatti (route /api/contatti). Stesse credenziali dei
# secret delle Edge Functions dell'evento: la casella autenticata resta il
# From tecnico, l'email di chi scrive finisce in Reply-To.
# Il destinatario NON si configura qui: si imposta in admin -> Impostazioni
# -> Email contatti.
SMTP_HOST=mail.example.it
SMTP_PORT=465
SMTP_USER=casella@example.it
SMTP_PASS=la-password-della-casella
# Facoltativo, default SMTP_USER. Formato "Nome <email@dominio>".
SMTP_FROM=Burrumballa <casella@example.it>
